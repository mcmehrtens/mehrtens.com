{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehrtens-com",
  "compatibility_date": "2026-07-03",
  "workers_dev": false,
  "preview_urls": true,
  "send_metrics": false,
  "routes": [{ "pattern": "mehrtens.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
