---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy - Matthew Mehrtens";
const description = "Privacy policy for mehrtens.com.";

interface PrivacyPolicyChange {
  date: string;
  change: string;
}

const privacyPolicyChanges: PrivacyPolicyChange[] = [
  {
    date: "2026-06-29",
    change: "First published",
  },
];

const ordered = [...privacyPolicyChanges].sort((a, b) =>
  b.date.localeCompare(a.date),
);
const latest = ordered[0];
const firstPublished = ordered[ordered.length - 1].date;
---

<BaseLayout title={title} description={description}>
  <article aria-labelledby="privacy-policy">
    <header>
      <h1 id="privacy-policy">Privacy Policy</h1>
      <p>
        Published: <time datetime={firstPublished}
          >{
            new Date(firstPublished).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }</time
        >
      </p>
      <p>
        Last updated: <time datetime={latest.date}
          >{
            new Date(latest.date).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }</time
        >
      </p>
    </header>
    <p>
      <b>Summary:</b> This is my personal website. I don't use cookies, analytics,
      tracking scripts, or advertising, and I don't collect, sell, or share your personal
      information. The only data collected while using this site is standard technical
      information my hosting provider logs automatically to deliver and secure the
      site.
    </p>

    <h2>Who runs this site</h2>
    <p>
      This website <a href={Astro.site}>mehrtens.com</a> is operated by Matthew Mehrtens
      as a personal, non-commercial project. If you have any questions about this
      policy, you can reach me at <a href="mailto:privacy@mehrtens.com"
        >privacy@mehrtens.com</a
      >.
    </p>

    <h2>Information I collect directly</h2>
    <p>
      None. There are no accounts to create, no forms to fill out, and no
      newsletter or comment system. I do not ask for or store your name, email
      address, or any other personal details through this site.
    </p>

    <h2>Information collected automatically</h2>
    <p>
      This is a static website hosted on Cloudflare. Like nearly all web hosting
      and content-delivery networks, Cloudflare automatically records some
      standard technical request data to deliver pages, serve assets, and
      protect my site from abuse. This may include:
    </p>
    <ul>
      <li>IP addresses</li>
      <li>Browser type and user-agent string</li>
      <li>
        The pages or files requested, and the date and time of the request
      </li>
      <li>Approximate, country-level location derived from the IP address</li>
    </ul>
    <p>
      This logging is done by Cloudflare as my hosting and CDN provider. I do
      not add any tracking of my own and I only see aggregate traffic statistics
      from Cloudflare's built-in dashboard analytics, which is server-side and
      cookieless. I do not use any of this information to identify you or to
      build a profile of you. See the <a href="#third-party-services"
        >Third-party services</a
      > section for more information.
    </p>

    <h2>Cookies</h2>
    <p>
      I don't set any cookies of my own. My hosting provider, Cloudflare, may
      set strictly-necessary cookies for security and bot protection.
    </p>

    <h2>Analytics and advertising</h2>
    <p>
      I do not use Google Analytics or any other analytics service, and I do not
      run advertising or third-party tracking scripts of any kind.
    </p>

    <h2 id="third-party-services">Third-party services</h2>
    <p>
      The only third party involved in operating this site is my hosting and
      content-delivery provider, <b>Cloudflare</b> (including Cloudflare's static
      hosting and object storage for assets). Cloudflare processes the technical request
      data described above on my behalf as part of serving the site. You can read
      how Cloudflare handles that data in its <a
        href="https://www.cloudflare.com/privacypolicy/">privacy policy</a
      >.
    </p>

    <h2>If you email me</h2>
    <p>
      If you choose to contact me by email, I'll receive whatever information
      you include in that message, and I'll keep it as ordinary correspondence
      so I can reply. I won't use it for anything else or share it without
      permission, except where I'm required to by law.
    </p>

    <h2>Your choices and rights</h2>
    <p>
      Because I don't collect personal information through this site, there's
      very little data for you to access, correct, or delete. Depending on where
      you live, you may have rights under privacy laws such as the GDPR (EU/UK)
      or the CCPA/CPRA (California). If you'd like to exercise any such right or
      simply ask what, if anything, I hold, email me at <a
        href="mailto:privacy@mehrtens.com">privacy@mehrtens.com</a
      > and I'll help.
    </p>

    <h2>Children's privacy</h2>
    <p>
      This site is intended for a general audience and is not directed at
      children, and I do not knowingly collect personal information from anyone,
      including children.
    </p>

    <h2>Changes to this policy</h2>
    <p>
      If my website changes—for example, if I ever add analytics, a contact
      form, or another service—I'll update this page, revise the "last updated"
      date above, and add to the running changelog below.
    </p>
    <table>
      <caption> Changes that have been made to this privacy policy. </caption>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Change</th>
        </tr>
      </thead>
      <tbody>
        {
          ordered.map((a) => (
            <tr>
              <td>
                <time datetime={a.date}>{a.date}</time>
              </td>
              <td>{a.change}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </article>
</BaseLayout>
