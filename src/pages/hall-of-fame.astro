---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Hall of Fame - Matthew Mehrtens";
const description =
  "Security researchers who have responsibly disclosed vulnerabilities affecting mehrtens.com.";

interface Acknowledgment {
  date: string;
  researcher: string;
  finding: string;
}

const acknowledgments: Acknowledgment[] = [
  // {
  //   date: "2026-06-28",
  //   researcher: "Jane Doe",
  //   finding: "Reflected cross-site scripting",
  // },
];

const ordered = [...acknowledgments].sort((a, b) =>
  b.date.localeCompare(a.date),
);
---

<BaseLayout title={title} description={description}
  ><h1>Security Hall of Fame</h1>
  <p>
    I’m grateful to the security researchers below, who responsibly disclosed
    vulnerabilities and helped keep this site safe. If you’ve found a security
    issue, please see the <a
      href="https://github.com/mcmehrtens/mehrtens.com/blob/main/SECURITY.md"
      >security policy</a
    > for how to report it.
  </p>

  {
    ordered.length === 0 ? (
      <p>
        No vulnerabilities have been reported yet. If you find one, you could be
        the first listed here. See the{" "}
        <a href="https://github.com/mcmehrtens/mehrtens.com/blob/main/SECURITY.md">
          security policy
        </a>{" "}
        to report it responsibly.
      </p>
    ) : (
      <table>
        <caption>
          Researchers who have responsibly disclosed security issues, most
          recent first.
        </caption>
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Researcher</th>
            <th scope="col">Finding</th>
          </tr>
        </thead>
        <tbody>
          {ordered.map((a) => (
            <tr>
              <td>
                <time datetime={a.date}>{a.date}</time>
              </td>
              <td>{a.researcher}</td>
              <td>{a.finding}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }</BaseLayout
>
