---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page Not Found - Matthew Mehrtens";
const description = "The page you’re looking for doesn’t exist.";
---

<BaseLayout title={title} description={description}
  ><h1>Page Not Found</h1>
  <p>
    The page you’re looking for doesn’t exist, or it’s moved. Double-check the
    address, or head back to the <a href="/">homepage</a>.
  </p></BaseLayout
>
