---
interface Props {
  ariaLabel: string;
  navLinks: { href: string; rel?: string; label: string }[];
}

const { ariaLabel, navLinks } = Astro.props;

const pathname = Astro.url.pathname;
---

<nav aria-label={ariaLabel}>
  <ul>
    {
      navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            rel={link.rel}
            aria-current={pathname === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
