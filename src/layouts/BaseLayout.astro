---
import Breadcrumb from "../components/Breadcrumb.astro";
import Nav from "../components/Nav.astro";
import { copyrightYears } from "../utils/copyright";
import {
  titleFor,
  tabTitleFor,
  descriptionFor,
  breadcrumbFor,
  breadcrumbListFor,
} from "../utils/routes";
import { personNode, orgNode } from "../utils/authors";

interface Props {
  graph?: Record<string, unknown>[];
  og?: {
    type?: "website" | "article" | "profile";
    article?: {
      publishedTime?: string;
      modifiedTime?: string;
      expirationTime?: string;
      author?: string | string[];
      section?: string;
      tag?: string | string[];
    };
    profile?: {
      firstName?: string;
      lastName?: string;
      username?: string;
      gender?: "male" | "female";
    };
  };
}
const { graph = [], og = {} } = Astro.props;

const ogType = og.type ?? "website";
const ogExtras: { property: string; content: string }[] = [];
const pushOg = (property: string, value?: string | string[]) => {
  if (!value) return;
  for (const content of Array.isArray(value) ? value : [value]) {
    ogExtras.push({ property, content });
  }
};
if (ogType === "article" && og.article) {
  const a = og.article;
  pushOg("article:published_time", a.publishedTime);
  pushOg("article:modified_time", a.modifiedTime);
  pushOg("article:expiration_time", a.expirationTime);
  pushOg("article:author", a.author);
  pushOg("article:section", a.section);
  pushOg("article:tag", a.tag);
}
if (ogType === "profile" && og.profile) {
  const p = og.profile;
  pushOg("profile:first_name", p.firstName);
  pushOg("profile:last_name", p.lastName);
  pushOg("profile:username", p.username);
  pushOg("profile:gender", p.gender);
}

const pathname = Astro.url.pathname;
const site = Astro.site;
const canonicalURL = new URL(pathname, site).href;

const title = titleFor(pathname);
const tabTitle = tabTitleFor(pathname);
const description = descriptionFor(pathname);

const renderBreadcrumb = breadcrumbFor(pathname).length > 1;
const breadcrumbGraph = renderBreadcrumb
  ? [breadcrumbListFor(pathname, site)]
  : [];

const publishedDate = "2026-07-02";
const publishedYear = 2026;

const years = copyrightYears(publishedYear);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    personNode(site),
    orgNode,
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      author: { "@id": `${site}#person` },
      copyrightHolder: { "@id": `${site}#person` },
      copyrightYear: publishedYear,
      datePublished: publishedDate,
      inLanguage: "en-US",
      isAccessibleForFree: true,
      license: "https://creativecommons.org/licenses/by/4.0/",
      publisher: { "@id": `${site}#person` },
      description: "The personal website of Matthew Mehrtens.",
      name: "mehrtens.com",
      url: `${site}`,
    },
    ...breadcrumbGraph,
    ...graph,
  ],
};
---

<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="author" href="/humans.txt" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{tabTitle}</title>
    <meta name="author" content="Matthew Mehrtens" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="mehrtens.com" />
    {ogExtras.map((m) => <meta property={m.property} content={m.content} />)}
    {
      /* when og:image ships, switch to "summary_large_image" (needs a 1200×630 image). */
    }
    <meta name="twitter:card" content="summary" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body>
    <a href="#main">Skip to main</a>

    <header>
      <a href="/">Matthew Mehrtens</a>
      <Nav
        ariaLabel="primary"
        navLinks={[
          { href: "/", label: titleFor("/") },
          { href: "/blog", label: titleFor("/blog") },
          { href: "/projects", label: titleFor("/projects") },
          { href: "/contact", label: titleFor("/contact") },
        ]}
      />
    </header>

    <main id="main" tabindex="-1">
      {renderBreadcrumb && <Breadcrumb />}
      <slot />
    </main>

    <footer>
      <p>
        <small>
          <a href="/">mehrtens.com</a> © {years} by <a href="/"
            >Matthew Mehrtens</a
          > under <a href="https://creativecommons.org/licenses/by/4.0/"
            ><abbr>CC</abbr> BY 4.0</a
          >
        </small>
      </p>
      <Nav
        ariaLabel="site information"
        navLinks={[
          {
            href: "https://github.com/mcmehrtens/mehrtens.com",
            label: "Source",
          },
          {
            href: "https://github.com/mcmehrtens/mehrtens.com/blob/main/LICENSE",
            rel: "license",
            label: "License",
          },
          { href: "/privacy", rel: "privacy-policy", label: "Privacy" },
          { href: "/terms", rel: "terms-of-service", label: "Terms" },
          { href: "/hall-of-fame", label: "Security" },
        ]}
      />
    </footer>
  </body>
</html>
