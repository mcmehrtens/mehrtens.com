{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "America/Chicago",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "separateMajorMinor": false,
  "prConcurrentLimit": 5,
  "constraints": {
    "pnpm": ">=11.9.0"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Group all npm updates into one PR (mirrors Dependabot all-dependencies)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["!lockFileMaintenance"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Group all GitHub Actions updates into one PR (mirrors Dependabot all-actions)",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group Astro into its own PR so an Astro major doesn't block other npm updates",
      "matchPackageNames": ["astro", "@astrojs/**"],
      "groupName": "astro"
    },
    {
      "description": "Hand-pinned CVE-remediation floors; do not update",
      "matchFileNames": ["pnpm-workspace.yaml"],
      "enabled": false
    },
    {
      "description": "TS 7 not yet supported by typescript-eslint or @astrojs/check",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
