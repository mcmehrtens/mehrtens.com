{
  "name": "mehrtens-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sign:security": "sh scripts/sign-security-txt.sh",
    "check:security": "sh scripts/check-security-txt.sh",
    "check": "astro check",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run check && pnpm run build",
    "test:a11y": "playwright test",
    "lint:links": "linkinator http://127.0.0.1:4321 --config linkinator.config.json",
    "check:site": "pnpm run lint:links && pnpm run test:a11y",
    "verify:site": "start-server-and-test \"astro preview --host 127.0.0.1 --port 4321\" http-get://127.0.0.1:4321 \"pnpm run check:site\"",
    "lighthouse:mobile": "LH_PROFILE=mobile lhci autorun --config=./lighthouserc.cjs",
    "lighthouse:desktop": "LH_PROFILE=desktop lhci autorun --config=./lighthouserc.cjs",
    "lighthouse:low-end": "LH_PROFILE=low-end lhci autorun --config=./lighthouserc.cjs",
    "lighthouse": "start-server-and-test \"astro preview --host 127.0.0.1 --port 4321\" http-get://127.0.0.1:4321 \"pnpm run lighthouse:mobile && pnpm run lighthouse:desktop && pnpm run lighthouse:low-end\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.7",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/css": "1.4.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "2.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "linkinator": "7.6.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "start-server-and-test": "3.0.11",
    "typescript-eslint": "8.63.0",
    "wrangler": "4.110.0"
  }
}
